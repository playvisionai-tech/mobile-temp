# Copy to .env and fill in. `./setup.sh` does this for you.
# Every variable here is validated by env.ts (Zod). Adding one there means
# adding it here too, or prebuild fails with STRICT_ENV_VALIDATION=1.

# Application Environment (development | preview | production)
EXPO_PUBLIC_APP_ENV=development

# API Configuration
EXPO_PUBLIC_API_URL=https://dummyjson.com/

# Example Variables
EXPO_PUBLIC_VAR_NUMBER=10
EXPO_PUBLIC_VAR_BOOL=true

# Build-time only secrets (no EXPO_PUBLIC prefix - NOT accessible in src folder)
SECRET_KEY=my-secret-key
APP_BUILD_ONLY_VAR=build-only-value

# Clerk — get the publishable key from https://dashboard.clerk.com
# (Settings -> API Keys). The app builds without a real key, but sign-in
# will not work until you set one.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
# Both optional. Leave blank unless you need them: an empty value is treated
# as unset, but a non-URL value will fail validation.
EXPO_PUBLIC_CLERK_API_URL=
EXPO_PUBLIC_CLERK_JWT_TEMPLATE=

# Firebase — there are NO Firebase variables here on purpose. The client config
# lives in firebase/<env>/ as GoogleService-Info.plist + google-services.json,
# and env.ts picks the directory from EXPO_PUBLIC_APP_ENV.
# ⚠️ Those files are currently PLACEHOLDERS with fake keys. The app builds and
# runs, but Analytics, Crashlytics and Remote Config report nothing until you
# replace them with real downloads from the Firebase console. See firebase/README.md.
